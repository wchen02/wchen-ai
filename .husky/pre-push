#!/usr/bin/env sh
# Same checks as CI; surfaces problems locally before push.
# E2e tests require a production build in out/; skip gracefully when it is absent.
pnpm lint && pnpm typecheck && pnpm test && (test -d out && pnpm test:e2e || echo "Skipping e2e: no build found in out/ — run pnpm build first to include e2e checks.")
