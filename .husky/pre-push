#!/usr/bin/env sh
# Same checks as CI; surfaces problems locally before push.
# E2E tests require a built `out/` directory (run `pnpm build` first).
pnpm lint && pnpm typecheck && pnpm test && (test -d out && pnpm test:e2e || echo "Skipping E2E: out/ not found. Run 'pnpm build' to enable E2E checks.")
